# Example image versions; pin validated image digests for your environment.
POSTGRES_IMAGE=postgres:17-alpine
REDIS_IMAGE=redis:7.4-alpine
APP_IMAGE=dujiao-next:local

# Optional host access to database containers; defaults to loopback only.
POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PUBLIC_PORT=5432
REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PUBLIC_PORT=6379
